---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'Contact — Mayank Bhasin',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Get in Touch"
    title="Let's Connect"
    subtitle="I'm always interested in connecting with people exploring AI transformation, innovative product strategies, or passionate about mentorship and growth."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Contact Information"
    subtitle="Reach out through any of these channels"
    columns={2}
    items={[
      {
        title: 'Book a Call',
        description: 'Schedule a 30-minute discovery call to discuss AI strategy, coaching, or collaboration opportunities.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'LinkedIn',
        description: 'Connect with me on LinkedIn for professional networking and collaboration opportunities.',
        icon: 'tabler:brand-linkedin',
      },
      {
        title: 'Email',
        description: 'Send me an email for consulting inquiries, speaking engagements, or mentorship requests.',
        icon: 'tabler:mail',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    title="Quick Links"
    items={[
      {
        title: 'Schedule a Call',
        description: 'https://calendly.com/mayankbhasin007/new-meeting',
      },
      {
        title: 'LinkedIn Profile',
        description: 'https://www.linkedin.com/in/mayank-bhasin-00a46b51/',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1596526131083-e8c633c948d2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2074&q=80',
      alt: 'Contact',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Ways to Connect
      </h3>
      <p class="text-muted mb-4">
        I'm based in the UK and work with clients across UK, EMEA, and the US. I'm open to:
      </p>
      <ul class="text-muted list-disc list-inside space-y-2">
        <li>AI transformation consulting for businesses</li>
        <li>Speaking engagements and workshops</li>
        <li>University partnerships and guest lectures</li>
        <li>Mentorship opportunities</li>
        <li>Product strategy collaboration</li>
      </ul>
    </Fragment>
  </Content>

  <!-- Call to Action Section -->

  <section class="bg-gradient-to-r from-blue-600 to-blue-800 dark:from-blue-800 dark:to-slate-900 py-20">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl font-bold text-white mb-4">Ready to Get Started?</h2>
      <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
        Book a free 30-minute discovery call to discuss how AI can transform your product strategy, team capabilities, or business operations.
      </p>
      <a
        href="https://calendly.com/mayankbhasin007/new-meeting"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 bg-white text-blue-700 text-lg font-semibold rounded-lg hover:bg-blue-50 transition-colors shadow-lg"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Schedule Your Discovery Call
      </a>
    </div>
  </section>

  <!-- Social Links Section -->

  <section class="bg-blue-50 dark:bg-slate-800 py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-8">Connect on Social Media</h2>
      <div class="flex justify-center gap-8 flex-wrap">
        <a
          href="https://www.linkedin.com/in/mayank-bhasin-00a46b51/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          LinkedIn
        </a>
      </div>
    </div>
  </section>
</Layout>
